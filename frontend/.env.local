NODE_ENV=development

# Mapbox GL JS access token (public, pk.*). Used by the Predictive Analytics
# mini map. Get one at https://account.mapbox.com/access-tokens/.
# If left empty, the card falls back to the static gradient heatmap.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoia2FyYW5ndXB0YTE5IiwiYSI6ImNtcHlsYmc5bjA3MGUydHBqZXcwNTdyczYifQ.6h7Wj0CWRbKQeRlJSXzPLA
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock fallback system — team-aware dual data source.
# true  → dev team members get live API + mock fallback.
# false → all users hit live API only (no mock data ever shown).
NEXT_PUBLIC_ENABLE_MOCK=true