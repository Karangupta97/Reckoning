# --------------------------------------------------------------------------
# RoadWatch AI — backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# --------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8000

# PostgreSQL (Supabase). Use the *pooled* connection string for DATABASE_URL
# (port 6543, ?pgbouncer=true) and the *direct* connection string for
# DIRECT_URL (port 5432). DIRECT_URL is used by `prisma migrate`.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Supabase project
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret

# --------------------------------------------------------------------------
# Email — Amazon SES via Nodemailer SMTP (transactional email)
# All five values below are REQUIRED; the server refuses to boot without them.
# Get SMTP credentials from the SES console:
#   SES → Account dashboard → SMTP settings → Create SMTP credentials.
# EMAIL_FROM must be a verified identity (domain or address) in your SES region.
# Use port 587 (STARTTLS) or 465 (implicit TLS).
# --------------------------------------------------------------------------
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_ses_smtp_username
SMTP_PASS=your_ses_smtp_password
EMAIL_FROM=noreply@roadwatch.ai
EMAIL_FROM_NAME=RoadWatch AI
# Recipient for operational/admin alerts (new-complaint notifications).
# Falls back to EMAIL_FROM when unset.
ADMIN_EMAIL=ops@roadwatch.ai
# Public base URL of the app, used to build links inside emails. No trailing slash.
APP_BASE_URL=https://roadwatch.ai

# JWT — secrets MUST be at least 64 characters and MUST differ from each other.
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=min_64_char_secret_here
JWT_REFRESH_SECRET=different_min_64_char_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --------------------------------------------------------------------------
# Admin auth realm — SEPARATE signing secrets from the citizen JWT secrets.
# Each MUST be >=64 chars, MUST differ from one another, AND MUST differ from
# the citizen JWT_ACCESS_SECRET / JWT_REFRESH_SECRET (enforced at startup).
# Generate with: openssl rand -hex 48
# --------------------------------------------------------------------------
ADMIN_JWT_ACCESS_SECRET=min_64_char_secret_different_from_citizen
ADMIN_JWT_REFRESH_SECRET=another_min_64_char_secret
ADMIN_JWT_ACCESS_EXPIRES=15m
ADMIN_JWT_REFRESH_EXPIRES=7d
ADMIN_FRONTEND_URL=https://roadwatch.ai
ADMIN_JWT_SECRET=min_64_char_secret_different_from_citizen_and_access_refresh

# Base URL the activation email link points to. The raw invite token is
# appended as ?token=<uuid>. No trailing slash.
ADMIN_ACTIVATION_BASE_URL=https://roadwatch.ai/authority/activate

# --------------------------------------------------------------------------
# Super Admin bootstrap (consumed ONLY by `npm run seed` — never via the API).
# Password must be >= 10 characters; full name 2–80 characters.
# --------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@roadwatch.ai
SUPER_ADMIN_PASSWORD=SuperSecure@2026!
SUPER_ADMIN_FULL_NAME=RoadWatch Super Admin

# Timing-attack prevention: a pre-computed bcrypt hash of a throwaway string,
# compared against during login when the email isn't found so response time is
# identical whether or not a user exists.
# Generate with:
#   node -e "import('bcryptjs').then(b=>b.default.hash('dummy_password_never_used',12).then(console.log))"
DUMMY_HASH=

# Optional: shared Redis store for rate limiting across instances.
# Leave unset to use the in-memory store (single instance / local dev).
# When set, BullMQ background queues (AI analysis, authority notify,
# confirmation email) are also enabled.
# REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------------
# AWS S3 — media storage (SmartReport uploads)
# Optional: the API still boots without these, but POST /api/upload returns a
# 503 STORAGE_UNAVAILABLE until they are configured.
# Media URLs are returned as SigV4 presigned S3 URLs (valid up to 7 days, the
# AWS maximum).
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=roadwatch-media

# --------------------------------------------------------------------------
# Reverse geocoding — OpenStreetMap Nominatim (free, no key required)
# A descriptive User-Agent is REQUIRED by the Nominatim usage policy.
# --------------------------------------------------------------------------
NOMINATIM_USER_AGENT=RoadWatchAI/1.0 (roadwatch@example.com)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --------------------------------------------------------------------------
# Reckoning AI — YOLOv8 road defect detection (HuggingFace Spaces)
# Optional: when unset, AI detection is skipped and complaints work normally.
# RECKONING_API_URL is the root URL of your HuggingFace Space deployment.
# RECKONING_API_SECRET authenticates requests to the model API.
# --------------------------------------------------------------------------
RECKONING_API_URL=https://YOUR_USERNAME-Reckoning.hf.space
RECKONING_API_SECRET=your_strong_secret_here
RECKONING_TIMEOUT_MS=30000
RECKONING_CONFIDENCE_THRESHOLD=0.40
