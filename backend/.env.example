# --------------------------------------------------------------------------
# RoadWatch AI — backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# --------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8000

# PostgreSQL (Supabase). Use the *pooled* connection string for DATABASE_URL
# (port 6543, ?pgbouncer=true) and the *direct* connection string for
# DIRECT_URL (port 5432). DIRECT_URL is used by `prisma migrate`.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Supabase project
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret

# Email (Mailjet) — transactional OTP delivery
MAILJET_API_KEY=your_mailjet_public_key
MAILJET_SECRET_KEY=your_mailjet_private_key
MJ_FROM_EMAIL=noreply@roadwatch.ai
MJ_FROM_NAME=RoadWatch AI

# JWT — secrets MUST be at least 64 characters and MUST differ from each other.
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=min_64_char_secret_here
JWT_REFRESH_SECRET=different_min_64_char_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Timing-attack prevention: a pre-computed bcrypt hash of a throwaway string,
# compared against during login when the email isn't found so response time is
# identical whether or not a user exists.
# Generate with:
#   node -e "import('bcryptjs').then(b=>b.default.hash('dummy_password_never_used',12).then(console.log))"
DUMMY_HASH=

# Optional: shared Redis store for rate limiting across instances.
# Leave unset to use the in-memory store (single instance / local dev).
# When set, BullMQ background queues (AI analysis, authority notify,
# confirmation email) are also enabled.
# REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------------
# AWS S3 — media storage (SmartReport uploads)
# Optional: the API still boots without these, but POST /api/upload returns a
# 503 STORAGE_UNAVAILABLE until they are configured.
# Media URLs are returned as SigV4 presigned S3 URLs (valid up to 7 days, the
# AWS maximum).
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=roadwatch-media

# --------------------------------------------------------------------------
# Reverse geocoding — OpenStreetMap Nominatim (free, no key required)
# A descriptive User-Agent is REQUIRED by the Nominatim usage policy.
# --------------------------------------------------------------------------
NOMINATIM_USER_AGENT=RoadWatchAI/1.0 (roadwatch@example.com)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
