generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
  schemas    = ["public"]
}

/// Placeholder model so the generated client has something to type-check.
/// Replace / extend with the real RoadWatch AI domain models.
model HealthPing {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_pings")
  @@schema("public")
}

/// A fully-onboarded RoadWatch AI account. Created only after a successful
/// OTP verification. `passwordHash` is a bcrypt digest — never the plaintext.
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  fullName      String
  passwordHash  String
  country       Country
  isVerified    Boolean        @default(false)
  role          Role           @default(CITIZEN)
  loginAttempts Int            @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  complaints    Complaint[]
  mediaUploads  MediaUpload[]
  refreshTokens RefreshToken[]

  @@map("users")
  @@schema("public")
}

/// Transient registration state held between `register` and `verify-otp`.
/// Stores the bcrypt-hashed OTP and the pending account's hashed password.
/// Consumed (set `used = true`) when verification succeeds.
model PendingVerification {
  id                String   @id @default(cuid())
  email             String   @unique
  otpHash           String
  fullName          String
  passwordHash      String
  country           Country
  expiresAt         DateTime
  attempts          Int      @default(0)
  resendCount       Int      @default(0)
  /// Start of the current rolling resend window; used to cap resends/hour.
  resendWindowStart DateTime @default(now())
  used              Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@map("pending_verifications")
  @@schema("public")
}

/// A persisted refresh-token handle. Only the SHA-256 `tokenHash` is stored,
/// never the raw JWT. Revoke by setting `revoked = true`.
model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revoked    Boolean   @default(false)
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  deviceInfo Json?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
  @@schema("public")
}

/// A government administrator in the RoadWatch AI hierarchy.
///
/// `passwordHash` is null until the invitee activates their account. Invite
/// tokens are stored ONLY as a SHA-256 hash (`inviteTokenHash`); the raw token
/// lives solely in the activation email link. Jurisdiction columns are null
/// for SUPER_ADMIN, district-scoped for DISTRICT_ADMIN, and district +
/// sub-district scoped for SUB_DISTRICT_ADMIN.
model AdminUser {
  id                  String              @id @default(uuid()) @db.Uuid
  fullName            String?
  email               String              @unique
  passwordHash        String
  phone               String?
  designation         String?
  department          String?
  role                AdminRole
  districtId          String?
  subDistrictId       String?
  invitedById         String?             @db.Uuid
  isActive            Boolean             @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int                 @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  // Relations
  invitedBy           AdminUser?          @relation("AdminInviters", fields: [invitedById], references: [id])
  invitedUsers        AdminUser[]         @relation("AdminInviters")
  refreshTokens       AdminRefreshToken[]
  district            District?           @relation(fields: [districtId], references: [id])
  subDistrict         SubDistrict?        @relation(fields: [subDistrictId], references: [id])
  invitationsSent     AdminInvitation[]   @relation("InvitedByRelation")

  @@index([role])
  @@index([districtId])
  @@index([subDistrictId])
  @@map("admin_users")
  @@schema("public")
}

/// A district jurisdiction with a PostGIS polygon boundary. The `geofence`
/// column is `geometry(Polygon, 4326)`; Prisma cannot write it directly, so it
/// is set via raw `ST_GeomFromGeoJSON` inside the create transaction. The GIST
/// index is created by the raw SQL migration.
model District {
  id           String                   @id @default(cuid())
  name         String
  country      Country
  geofence     Unsupported("geometry")?
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  admins       AdminUser[]
  subDistricts SubDistrict[]
  invitations  AdminInvitation[]

  @@index([country])
  @@map("districts")
  @@schema("public")
}

/// A sub-district jurisdiction nested inside exactly one {@link District}. Its
/// `geofence` MUST be fully contained within the parent district boundary
/// (enforced with `ST_Within` at invite time).
model SubDistrict {
  id         String                   @id @default(cuid())
  name       String
  districtId String
  geofence   Unsupported("geometry")?
  isActive   Boolean                  @default(true)
  createdAt  DateTime                 @default(now())
  admins     AdminUser[]
  tickets    Ticket[]
  district   District                 @relation(fields: [districtId], references: [id])
  invitations AdminInvitation[]

  @@index([districtId])
  @@map("sub_districts")
  @@schema("public")
}

/// A persisted admin refresh-token handle. Only the SHA-256 `tokenHash` is
/// stored, never the raw JWT. Mirrors the citizen {@link RefreshToken} model
/// but is bound to the separate admin auth realm.
model AdminRefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  ipAddress   String
  userAgent   String
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_refresh_tokens")
  @@schema("public")
}

model AdminInvitation {
  id            String       @id @default(uuid()) @db.Uuid
  token         String       @unique
  email         String
  role          AdminRole
  districtId    String?
  subDistrictId String?
  invitedById   String       @db.Uuid
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  // Relations
  invitedBy     AdminUser    @relation("InvitedByRelation", fields: [invitedById], references: [id])
  district      District?    @relation(fields: [districtId], references: [id])
  subDistrict   SubDistrict? @relation(fields: [subDistrictId], references: [id])

  @@index([invitedById])
  @@index([districtId])
  @@index([subDistrictId])
  @@map("admin_invitations")
  @@schema("public")
}

/// An audit record raised when a complaint reaches a terminal escalation
/// state (e.g. max escalation reached, or both tiers breached their SLA). Used
/// to drive the public "Unresolved" surface and accountability reporting.
model AuditFlag {
  id              String    @id @default(cuid())
  complaintId     String
  districtId      String?
  subDistrictId   String?
  reason          String
  resolvedByAdmin String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([complaintId])
  @@index([reason])
  @@map("audit_flags")
  @@schema("public")
}

/// A citizen-submitted road issue.
///
/// Identity is hybrid-anonymous: `userId` is ALWAYS stored (for moderation and
/// abuse prevention) but is never exposed publicly. When `isAnonymous` is true
/// the public/authority surfaces show "Anonymous Citizen" instead of the name.
///
/// `location` is a PostGIS `geography(Point,4326)` column. Prisma cannot create
/// or back-fill it directly, so it is added/maintained via the raw SQL
/// migration in `prisma/migrations` and written with a raw `UPDATE` inside the
/// create transaction.
model Complaint {
  id                    String                    @id @default(cuid())
  userId                String
  isAnonymous           Boolean                   @default(false)
  category              IssueCategory
  description           String?
  suggestedFix          String?
  latitude              Float
  longitude             Float
  location              Unsupported("geography")?
  address               String?
  roadName              String?
  roadNumber            String?
  landmark              String?
  direction             String?
  country               Country
  aiDetected            Boolean                   @default(false)
  aiCategory            IssueCategory?
  aiConfidence          Float?
  aiRawResult           Json?
  aiAnnotatedImageKey   String?
  aiResult              ComplaintAiResult?
  severity              SeverityLevel             @default(MEDIUM)
  status                ComplaintStatus           @default(SUBMITTED)
  assignedTo            String?
  ticketNumber          String                    @unique
  upvotes               Int                       @default(0)
  viewCount             Int                       @default(0)
  deletedAt             DateTime?
  deletedBy             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  escalatedAt           DateTime?
  escalatedToDistrictId String?
  escalationLevel       Int                       @default(0)
  escalationReason      String?
  resolutionNote        String?
  resolvedAt            DateTime?
  resolvedByAdmin       String?
  slaDeadline           DateTime?
  ticketId              String?                   @unique
  ticket                Ticket?
  media                 ComplaintMedia[]
  authority             Authority?                @relation(fields: [assignedTo], references: [id])
  user                  User                      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([country])
  @@index([severity])
  @@index([createdAt])
  @@index([escalatedToDistrictId])
  @@map("complaints")
  @@schema("public")
}

/// Persisted AI analysis result for a complaint.
model ComplaintAiResult {
  id                   String          @id @default(cuid())
  complaintId          String          @unique
  complaint            Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  annotatedImageS3Key  String?
  suggestedCategory    IssueCategory?
  suggestedSeverity    SeverityLevel?
  confidence           Float?
  totalDetected        Int             @default(0)
  detections           Json?
  inferenceMs          Int?
  message              String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([complaintId])
  @@map("complaint_ai_results")
  @@schema("public")
}

/// Join row binding an uploaded media asset to a complaint, preserving display
/// order and which asset is the primary (thumbnail) one.
model ComplaintMedia {
  id          String      @id @default(cuid())
  complaintId String
  mediaId     String
  isPrimary   Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  complaint   Complaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  media       MediaUpload @relation(fields: [mediaId], references: [id])

  @@unique([complaintId, mediaId])
  @@index([complaintId])
  @@index([mediaId])
  @@map("complaint_media")
  @@schema("public")
}

/// A single uploaded file (image or video) stored in S3.
///
/// Created by `POST /api/upload` BEFORE it is ever linked to a complaint.
/// `linkedAt` is stamped when the asset is attached to a complaint so it can
/// never be reused for a second complaint. `isDeleted` supports soft cleanup
/// when its owning complaint is removed.
model MediaUpload {
  id         String           @id @default(cuid())
  userId     String
  s3Key      String           @unique
  url        String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  duration   Float?
  linkedAt   DateTime?
  isDeleted  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  complaints ComplaintMedia[]
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("media_uploads")
  @@schema("public")
}

/// A government body a complaint can be auto-assigned to, scoped by a PostGIS
/// `geography(Polygon,4326)` boundary. The polygon is managed via raw SQL.
model Authority {
  id         String                    @id @default(cuid())
  name       String
  type       String
  country    Country
  boundary   Unsupported("geography")?
  email      String
  phone      String?
  isActive   Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  complaints Complaint[]

  @@index([country])
  @@map("authorities")
  @@schema("public")
}

/// Atomic, per-country monotonic counter used to mint sequential ticket
/// numbers (e.g. `RW-IN-2026-000042`). One row per (country, year); the
/// `lastSeq` is bumped inside the complaint-create transaction.
model TicketCounter {
  country   Country
  year      Int
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([country, year])
  @@map("ticket_counters")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)

  @@schema("public")
}

/// BIMSTEC member states supported by RoadWatch AI.
enum Country {
  INDIA
  BANGLADESH
  NEPAL
  SRI_LANKA
  MYANMAR
  THAILAND
  BHUTAN

  @@schema("public")
}

/// Account roles. New citizens default to CITIZEN.
enum Role {
  CITIZEN
  AUTHORITY
  ADMIN

  @@schema("public")
}

/// The three administrative tiers. SUPER_ADMIN is seeded only; DISTRICT_ADMIN
/// is invited by a SUPER_ADMIN; SUB_DISTRICT_ADMIN is invited by a
/// DISTRICT_ADMIN. Role is the single source of truth for RBAC decisions.
enum AdminRole {
  SUPER_ADMIN
  DISTRICT_ADMIN
  SUB_DISTRICT_ADMIN

  @@schema("public")
}

/// Lifecycle of an admin account.
/// PENDING     — invited, not yet activated (no password set).
/// ACTIVE      — activated and able to log in.
/// SUSPENDED   — temporarily blocked by a higher tier; reversible.
/// DEACTIVATED — soft-deleted; cannot log in (terminal via API).
enum AdminStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@schema("public")
}

/// Road-issue categories a citizen can report. `OTHERS` is the catch-all.
enum IssueCategory {
  POTHOLE
  CRACKS_DAMAGE
  FADED_LANE_MARKINGS
  MISSING_BROKEN_SIGNBOARD
  POOR_STREET_LIGHTING
  ENCROACHMENT
  OTHERS

  @@schema("public")
}

/// Lifecycle of a complaint as it moves through triage and resolution.
/// Every transition is expected to emit an audit log, a timeline event, and
/// a notification (handled by the workflow layer — SOON).
enum ComplaintStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  ESCALATED

  @@schema("public")
}

/// Relative urgency of a complaint. Set heuristically at creation (AI hints +
/// keyword scan) and overridable by an admin later.
enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("public")
}

// ---------------------------------------------------------------------------
// Ticket System — authority assignment & SLA tracking
// ---------------------------------------------------------------------------

/// Lifecycle of a ticket through resolution / rejection.
enum TicketStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  REJECTED
  UNASSIGNED
  ESCALATED

  @@schema("public")
}

/// A ticket assigned to a sub-district admin for resolution tracking.
model Ticket {
  id                    String                @id @default(cuid())
  ticketNumber          String                @unique
  complaintId           String                @unique
  complaint             Complaint             @relation(fields: [complaintId], references: [id])
  subDistrictId         String?
  subDistrict           SubDistrict?          @relation(fields: [subDistrictId], references: [id])
  districtId            String?
  assignedAdminId       String?
  previousAdminId       String?
  status                TicketStatus          @default(OPEN)
  priority              SeverityLevel
  slaDeadline           DateTime
  slaWarningNotifiedAt  DateTime?
  escalationLevel       Int                   @default(0)
  escalatedAt           DateTime?
  resolvedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?
  notes                 TicketNote[]
  statusHistory         TicketStatusHistory[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([status])
  @@index([subDistrictId])
  @@index([assignedAdminId])
  @@index([slaDeadline])
  @@map("tickets")
  @@schema("public")
}

/// An internal note attached to a ticket by an admin.
model TicketNote {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_notes")
  @@schema("public")
}

/// Audit trail of every status change on a ticket.
model TicketStatusHistory {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id])
  status      TicketStatus
  changedById String
  note        String?
  changedAt   DateTime     @default(now())

  @@index([ticketId])
  @@map("ticket_status_history")
  @@schema("public")
}
