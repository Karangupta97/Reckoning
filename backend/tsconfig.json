{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/modules/admin/auth/**/*.ts",
    "src/modules/admin/district/**/*.ts",
    "src/modules/admin/subDistrict/**/*.ts",
    "src/modules/admin/management/**/*.ts",
    "src/modules/admin/admin.shared.ts"
  ]
}
